# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Control Plane & Database Configuration
DATABASE_URL="postgresql://git2live:git2live_secret@postgres:5432/git2live"
REDIS_URL="redis://:redis_secret@redis:6379/0"
JWT_SECRET="git2live_jwt_super_secret_change_in_production"
DOMAIN="git2live.dev"

# Storage Configuration (MinIO / S3 compatible)
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="git2live_minio_admin"
S3_SECRET_KEY="git2live_minio_secret"
S3_BUCKET_NAME="git2live-artifacts"

# GitHub App Integration
GITHUB_APP_ID=""
GITHUB_PRIVATE_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Provider Configuration
AI_PROVIDER="gemini"
AI_API_KEY="MY_GEMINI_API_KEY"
AI_REPAIR_ENABLED="true"

# Sandboxed Execution Limits
MAX_BUILD_TIMEOUT_SEC="600"
MAX_RUNTIME_IDLE_TIMEOUT_MIN="30"
DEFAULT_CPU_LIMIT="1.0"
DEFAULT_MEMORY_LIMIT="1024M"

